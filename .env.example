# ==============================================================================
# KATALYST — Environment Variables Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Shared AI Gateway & Cloudflare Workers AI (Server-only credentials)
# ------------------------------------------------------------------------------
# Default hosted model provider for KATALYST shared inference.
AI_PROVIDER=cloudflare
# AI_MODEL applies to OpenAI's built-in catalog hint.
AI_MODEL=gpt-6-luna
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# ------------------------------------------------------------------------------
# 2. BYOK (Bring-Your-Own-Key) Server Defaults (Optional)
# ------------------------------------------------------------------------------
# Server environment fallback keys for development. Tab-session keys can also be provided in UI.
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ------------------------------------------------------------------------------
# 3. Supabase Authentication & Account Persistence
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_anon_key_here
# Server-only service role key for admin user management and account deletion. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ------------------------------------------------------------------------------
# 4. Admin Bootstrap Configuration
# ------------------------------------------------------------------------------
# Comma-separated list of admin email addresses recognized for gateway administration.
KATALYST_ADMIN_EMAILS=admin@example.com

# ------------------------------------------------------------------------------
# 5. Brevo (Sendinblue) Transactional Email Service
# ------------------------------------------------------------------------------
# Server-only Brevo API key for welcome emails, quota notifications, and alerts.
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=KATALYST

# Optional signing secret for guest HMAC sessions (falls back to SUPABASE_SERVICE_ROLE_KEY if omitted).
GUEST_SESSION_SECRET=your_random_guest_signing_secret_here
