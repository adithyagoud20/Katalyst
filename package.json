{
  "name": "katalyst",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first engineering learning platform with a provider-powered tutor and secondary AI workspace.",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "predev": "node scripts/copy-wasmer-browser-runtime.mjs",
